<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.meteo"
          path="/org/gnome/shell/extensions/meteo/">

    <key name="auto-location" type="b">
      <default>true</default>
      <summary>Detect location automatically</summary>
      <description>Use system location or IP-based detection instead of a manual place</description>
    </key>

    <key name="location-latitude" type="d">
      <default>49.589</default>
      <summary>Latitude</summary>
    </key>

    <key name="location-longitude" type="d">
      <default>34.553</default>
      <summary>Longitude</summary>
    </key>

    <key name="location-name" type="s">
      <default>'My location'</default>
      <summary>Place display name</summary>
    </key>

    <key name="units" type="s">
      <choices>
        <choice value="metric"/>
        <choice value="imperial"/>
      </choices>
      <default>'metric'</default>
      <summary>Measurement units</summary>
      <description>metric = °C / km/h, imperial = °F / mph</description>
    </key>

    <key name="language" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="uk"/>
        <choice value="ru"/>
        <choice value="en"/>
      </choices>
      <default>'auto'</default>
      <summary>Interface language</summary>
      <description>Interface language: auto, uk, ru, en</description>
    </key>

    <key name="show-temperature" type="b">
      <default>true</default>
      <summary>Show temperature in the panel</summary>
    </key>

    <key name="show-icon" type="b">
      <default>true</default>
      <summary>Show the weather icon in the panel</summary>
    </key>

    <key name="hour-format" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="12h"/>
        <choice value="24h"/>
      </choices>
      <default>'auto'</default>
      <summary>Clock style for hour labels</summary>
      <description>auto follows the GNOME clock-format setting, falling back to locale</description>
    </key>

    <key name="refresh-minutes" type="i">
      <range min="5" max="120"/>
      <default>15</default>
      <summary>Weather refresh interval in minutes</summary>
    </key>

    <key name="provider" type="s">
      <choices>
        <choice value="open-meteo"/>
        <choice value="met-norway"/>
        <choice value="noaa-nws"/>
      </choices>
      <default>'open-meteo'</default>
      <summary>Weather data provider</summary>
      <description>open-meteo = Open-Meteo global, met-norway = MET Norway, noaa-nws = US NOAA</description>
    </key>

    <key name="om-model" type="s">
      <choices>
        <choice value="best_match"/>
        <choice value="ecmwf_ifs"/>
        <choice value="icon_seamless"/>
        <choice value="gfs_seamless"/>
        <choice value="gem_global"/>
      </choices>
      <default>'best_match'</default>
      <summary>Open-Meteo forecast model</summary>
      <description>Forecast model for Open-Meteo service</description>
    </key>

  </schema>
</schemalist>
