msgstr "Періодичність фонового завантаження даних"

#: extension/prefs.js:360
msgid "About GnomeMeteo"
msgstr "Про GnomeMeteo"

#: extension/prefs.js:374
msgid "Clean, modern weather indicator and forecast for GNOME Shell"
msgstr "Лаконічний, сучасний індикатор погоди та прогноз для GNOME Shell"

#: extension/prefs.js:377
msgid "Releases"
msgstr "Релізи"


#: extension/prefs.js
msgid "What is the difference?"
msgstr "Яка різниця?"

#: extension/prefs.js
msgid "Full data set: humidity, pressure, UV, visibility, rain probability. The best choice almost everywhere."
msgstr "Повний набір даних: вологість, тиск, UV, видимість, імовірність опадів. Найкращий вибір майже скрізь."

#: extension/prefs.js
msgid "Strong in Europe. Publishes no rain probability and no visibility: these are shown as “—”."
msgstr "Сильний у Європі. Не публікує імовірність опадів і видимість: вони показуються як «—»."

#: extension/prefs.js
msgid "United States only. Other regions return an error."
msgstr "Лише США. Для інших регіонів повертає помилку."

#: extension/prefs.js
msgid "Ukraine: use Open-Meteo with “Best match”."
msgstr "Україна: Open-Meteo з «Найкращою відповідністю»."

#: extension/prefs.js
msgid "Picks the best local models automatically (ICON and ECMWF in Europe). Full data set."
msgstr "Сам обирає найкращі локальні моделі (ICON та ECMWF у Європі). Повний набір даних."

#: extension/prefs.js
msgid "Often the most accurate for days 3–7 in Europe. No UV index."
msgstr "Часто найточніша на 3–7 днів у Європі. Без UV-індексу."

#: extension/prefs.js
msgid "Strong for Central and Eastern Europe. No UV index."
msgstr "Сильна для Центральної та Східної Європи. Без UV-індексу."

#: extension/prefs.js
msgid "Global model, best suited for North America. Full data set."
msgstr "Глобальна модель, найкраще підходить для Північної Америки. Повний набір даних."

#: extension/prefs.js
msgid "Best suited for North America. No UV index, visibility or CAPE."
msgstr "Найкраще підходить для Північної Америки. Без UV-індексу, видимості та CAPE."

#: extension/prefs.js
msgid "Ukraine: “Best match”, or ECMWF IFS for the longer range."
msgstr "Україна: «Найкраща відповідність» або ECMWF IFS для довшого прогнозу."
